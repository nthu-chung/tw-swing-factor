# 複製成 .env 後由 shell/direnv 載入；程式本身不會讀取或提交 .env。
FINMIND_TOKEN=

# Frozen research snapshot（正式回測請填固定日期）
SWING_SNAPSHOT_END=2026-06-22

# IS/OS：ratio 或 weeks
SWING_EVAL_SPLIT_MODE=ratio
SWING_IS_RATIO=0.70
SWING_IS_WEEKS=52
SWING_OS_WEEKS=26
SWING_EMBARGO_DAYS=20

# API 瞬斷有界重試
SWING_API_MAX_RETRIES=3
SWING_API_RETRY_BACKOFF=1.0

# 回測股數／資金。研究比較預設允許小數股；部署敏感度可改 regular_lot。
SWING_ORDER_SIZE_MODE=research_fractional
SWING_INITIAL_CAPITAL=1000000
# 券商自訂最低手續費；0 表示不設最低值，不代表你的券商實際收費。
SWING_MIN_COMMISSION=0
# 尚未完成官方資料覆蓋驗證前維持 derived_prev_close。
SWING_PRICE_LIMIT_SOURCE=derived_prev_close
